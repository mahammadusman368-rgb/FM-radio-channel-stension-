local function loadFavorites()
    local fav_radio = prefs.getString("favorites_radio", "[]")
    local fav_tv = prefs.getString("favorites_tv", "[]")
    pcall(function() list_favorites_radio = cjson.decode(fav_radio) end)
    pcall(function() list_favorites_tv = cjson.decode(fav_tv) end)
    if type(list_favorites_radio) ~= "table" then list_favorites_radio = {} end
    if type(list_favorites_tv) ~= "table" then list_favorites_tv = {} end
end

local function saveFavorites()
    editor.putString("favorites_radio", cjson.encode(list_favorites_radio))
    editor.putString("favorites_tv", cjson.encode(list_favorites_tv))
    editor.apply()
end

local function isFavorite(url, play_type)
    local list = (play_type == "RADIO") and list_favorites_radio or list_favorites_tv
    for i, v in ipairs(list) do
        if v.u == url then return true, i end
    end
    return false, 0
end

loadFavorites()

