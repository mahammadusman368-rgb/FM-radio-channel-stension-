    local function fetchAPIAndCategories(code, cname)
        views.tv_loading_cat.setVisibility(View.VISIBLE)
        views.cat_fm.setVisibility(View.GONE) views.cat_radio.setVisibility(View.GONE) views.cat_islami_radio.setVisibility(View.GONE)
        views.cat_tv_news.setVisibility(View.GONE) views.cat_tv_ent.setVisibility(View.GONE) views.cat_tv_islamic.setVisibility(View.GONE)
        views.cat_tv_music.setVisibility(View.GONE) views.cat_tv_sports.setVisibility(View.GONE) views.cat_tv_other.setVisibility(View.GONE)
        
        if current_play_type == "RADIO" then
            if code == "ALL" then
                categorizeRadioChannels({}, code)
                views.tv_loading_cat.setVisibility(View.GONE)
                views.btn_select_country.setText("Country: " .. cname .. " (Total: " .. total_country_channels .. ")")
                views.cat_fm.setVisibility(#list_fm > 0 and View.VISIBLE or View.GONE)
                views.cat_radio.setVisibility(#list_radio > 0 and View.VISIBLE or View.GONE)
                views.cat_islami_radio.setVisibility(#list_islami_radio > 0 and View.VISIBLE or View.GONE)
                return
            end
            Http.get(active_radio_api .. "/stations/bycountrycodeexact/" .. code .. "?limit=5000&hidebroken=true", function(code_http, content)
                mainHandler.post(function()
                    views.tv_loading_cat.setVisibility(View.GONE)
                    if code_http == 200 then
                        local s, d = pcall(cjson.decode, content)
                        if s then categorizeRadioChannels(d, code) else categorizeRadioChannels({}, code) end
                    else categorizeRadioChannels({}, code) end
                    views.btn_select_country.setText("Country: " .. cname .. " (Total: " .. total_country_channels .. ")")
                    views.cat_fm.setVisibility(#list_fm > 0 and View.VISIBLE or View.GONE)
                    views.cat_radio.setVisibility(#list_radio > 0 and View.VISIBLE or View.GONE)
                    views.cat_islami_radio.setVisibility(#list_islami_radio > 0 and View.VISIBLE or View.GONE)
                    tts("Radio Channels loaded")
                end)
            end)
            
        elseif current_play_type == "TV" then
            Http.get(tv_channels_api, function(code_http, content)
                mainHandler.post(function()
                    views.tv_loading_cat.setVisibility(View.GONE)
                    if code_http == 200 then
                        local s, d = pcall(cjson.decode, content)
                        if s then categorizeTVChannels(d, code) else categorizeTVChannels({}, code) end
                    else categorizeTVChannels({}, code) end
                    
                    views.btn_select_country.setText("Country: " .. cname .. " (Total: " .. total_country_channels .. ")")
                    views.cat_tv_news.setVisibility(#list_tv_news > 0 and View.VISIBLE or View.GONE)
                    views.cat_tv_ent.setVisibility(#list_tv_ent > 0 and View.VISIBLE or View.GONE)
                    views.cat_tv_islamic.setVisibility(#list_tv_islamic > 0 and View.VISIBLE or View.GONE)
                    views.cat_tv_music.setVisibility(#list_tv_music > 0 and View.VISIBLE or View.GONE)
                    views.cat_tv_sports.setVisibility(#list_tv_sports > 0 and View.VISIBLE or View.GONE)
                    views.cat_tv_other.setVisibility(#list_tv_other > 0 and View.VISIBLE or View.GONE)
                    tts("TV Channels loaded")
                end)
            end)
        end
    end
    
    views.lv_countries.setOnItemClickListener(AdapterView.OnItemClickListener{
