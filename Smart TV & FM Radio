-- Categorize API Data (Radio + TV)
-- ==========================================
local function categorizeRadioChannels(api_data, country_code)
    list_fm = {} list_radio = {} list_islami_radio = {}
    local unique_urls = {}

    local function addChannel(name, url, code)
        if url == nil or url == "" or unique_urls[url] then return end
        unique_urls[url] = true
        local lname = string.lower(name)
        local ch = {n = name, u = url, c = code, type = "RADIO"}
        
        if string.find(lname, "islam") or string.find(lname, "quran") or string.find(lname, "makkah") or string.find(lname, "madinah") or string.find(lname, "tilawat") then
            table.insert(list_islami_radio, ch)
        elseif string.find(lname, "fm ") or string.find(lname, " fm") or string.find(lname, "fm") then
            table.insert(list_fm, ch)
        else
            table.insert(list_radio, ch) 
        end
    end

    for _, ch in ipairs(base_radio_channels) do
        if ch.c == country_code or country_code == "ALL" then addChannel(ch.n, ch.u, ch.c) end
    end
    
    if api_data and type(api_data) == "table" then
        for i=1, #api_data do addChannel(api_data[i].name or "Unknown", api_data[i].url_resolved or api_data[i].url or "", country_code) end
    end
    total_country_channels = #list_fm + #list_radio + #list_islami_radio
end

local function categorizeTVChannels(api_data, country_code)
    list_tv_news = {} list_tv_ent = {} list_tv_islamic = {} list_tv_music = {} list_tv_sports = {} list_tv_other = {}
    local unique_urls = {}

    local function addChannel(name, url, code, cat)
        if url == nil or url == "" or unique_urls[url] then return end
        unique_urls[url] = true
        
        local lname = string.lower(name)
        local ccat = string.lower(cat or "")
        local ch = {n = name, u = url, c = code, type = "TV"}
        
        if ccat == "news" or string.find(lname, "news") then table.insert(list_tv_news, ch)
        elseif ccat == "entertainment" or ccat == "movies" or string.find(lname, "tv") or string.find(lname, "cinema") then table.insert(list_tv_ent, ch)
        elseif ccat == "music" or string.find(lname, "music") then table.insert(list_tv_music, ch)
        elseif ccat == "sports" or string.find(lname, "sport") or string.find(lname, "cricket") then table.insert(list_tv_sports, ch)
        elseif ccat == "islamic" or string.find(lname, "islam") or string.find(lname, "madani") or string.find(lname, "quran") then table.insert(list_tv_islamic, ch)
        else table.insert(list_tv_other, ch) end
    end

    for _, ch in ipairs(base_tv_channels) do
        if ch.c == country_code or ch.c == "ALL" then addChannel(ch.n, ch.u, ch.c, ch.cat) end
    end
    
    if api_data and type(api_data) == "table" then
        for i=1, #api_data do 
            local cat = (api_data[i].categories and #api_data[i].categories > 0) and api_data[i].categories[1] or "Other"
            addChannel(api_data[i].name or "Unknown", api_data[i].url or "", country_code, cat) 
        end
    end
    total_country_channels = #list_tv_news + #list_tv_ent + #list_tv_islamic + #list_tv_music + #list_tv_sports + #list_tv_other
end-- ==========================================
-- Universal Player (Radio + TV) with 15s Timeout & TTS
-- ==========================================
local views = {} 
local channelAdapter = nil

local function updatePlayerUI(station, status)
    if not station then return end 
    if views.tv_player_status then views.tv_player_status.setText(status or "Playing: " .. station.n) end
    if views.btn_play_pause then views.btn_play_pause.setText(isPlaying and "Pause" or "Play") end
    if views.btn_fav then
        local isFav, _ = isFavorite(station.u, station.type)
        views.btn_fav.setText(isFav and "Remove from Favorite" or "Add to Favorite")
    end
end

local function playStation(index, channel_list)
    if not channel_list or #channel_list == 0 then 
        tts("List khali hai.") 
        return 
    end
    if index > #channel_list then index = 1 end
    if index < 1 then index = #channel_list end
    
    current_station_index = index
    local station = channel_list[index]
    current_play_type = station.type
    
    -- Stop existing streams
    pcall(function() radio_player.stop() radio_player.reset() end)
    pcall(function() 
        if tv_video_view then 
            tv_video_view.stopPlayback() 
            tv_video_view.setVisibility(View.GONE) 
        end 
    end)
    
    isPlaying = false
    updatePlayerUI(station, "Status: Starting " .. station.n .. "...")
    tts(station.n .. " load ho raha hai")
    
    if playRunnable then mainHandler.removeCallbacks(playRunnable) end
    if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) end
    
    -- 1 SECOND DELAY FOR FAST PLAY
    playRunnable = Runnable{
        run = function()
            pcall(function()
                if station.type == "RADIO" then
                    radio_player.setAudioStreamType(AudioManager.STREAM_MUSIC)
                    radio_player.setDataSource(station.u)
                    radio_player.prepareAsync()
                    updatePlayerUI(station, "Status: Buffering " .. station.n .. "...")
                    
                    radio_player.setOnPreparedListener(MediaPlayer.OnPreparedListener{
                        onPrepared = function(mp)
                            mp.start()
                            isPlaying = true
                            if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) timeoutRunnable = nil end
                            updatePlayerUI(station, "Playing: " .. station.n)
                            tts(station.n .. " play ho gaya hai")
                        end
                    })
                    radio_player.setOnErrorListener(MediaPlayer.OnErrorListener{
                        onError = function(mp, what, extra)
                            isPlaying = false
                            updatePlayerUI(station, "Status: Error Playing " .. station.n)
                            return true
                        end
                    })
                    
                elseif station.type == "TV" then
                    local videoMode = prefs.getString("video_display_mode", "ON")
                    if videoMode == "ON" and tv_video_view then
                        tv_video_view.setVisibility(View.VISIBLE)
                    end
                    tv_video_view.setVideoURI(Uri.parse(station.u))
                    tv_video_view.setOnPreparedListener(MediaPlayer.OnPreparedListener{
                        onPrepared = function(mp)
                            mp.start()
                            isPlaying = true
                            if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) timeoutRunnable = nil end
                            updatePlayerUI(station, "Playing: " .. station.n)
                            tts(station.n .. " play ho gaya hai")
                        end
                    })
                    tv_video_view.setOnErrorListener(MediaPlayer.OnErrorListener{
                        onError = function(mp, what, extra)
                            isPlaying = false
                            updatePlayerUI(station, "Status: Error Playing " .. station.n)
                            return true
                        end
                    })
                    tv_video_view.start()
                end
            end)
            
            -- 15 SECOND TIMEOUT AUTO-REMOVE LOGIC
            timeoutRunnable = Runnable{
                run = function()
                    if not isPlaying then
                        tts(station.n .. " server down hai, isko remove kar ke agla channel play kar raha hoon.")
                        table.remove(channel_list, current_station_index)
                        
                        -- Update adapter instantly
                        if channelAdapter then
                            channelAdapter.clear()
                            for _, v in ipairs(channel_list) do channelAdapter.add(v.n) end
                        end
                        
                        -- Remove from Favorites if playing from there
                        if current_category_title == "Favorites" then 
                            local isFav, fIdx = isFavorite(station.u, station.type)
                            if isFav then 
                                if station.type == "RADIO" then table.remove(list_favorites_radio, fIdx)
                                else table.remove(list_favorites_tv, fIdx) end
                                saveFavorites() 
                            end
                        end
                        
                        -- Play Next Automatic
                        if #channel_list > 0 then
                            if current_station_index > #channel_list then current_station_index = 1 end
                            playStation(current_station_index, channel_list)
                        else
                            tts("List khatam ho gayi.")
                            updatePlayerUI({n="None", u="", type=station.type}, "Status: No Channels Left")
                        end
                    end
                end
            }
            mainHandler.postDelayed(timeoutRunnable, 15000) -- EXACTLY 15 SECONDS WAIT
        end
    }
    mainHandler.postDelayed(playRunnable, 1000) -- EXACTLY 1 SECOND PLAY DELAY
end

