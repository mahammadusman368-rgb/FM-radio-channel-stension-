    -- Event: Channel List Actions
    views.btn_list_search.onClick = function()
        local q = string.lower(views.edt_list_search.getText().toString())
        channelAdapter.clear()
        local temp = {}
        for _, ch in ipairs(current_playing_list) do
            if string.find(string.lower(ch.n), q, 1, true) then 
                channelAdapter.add(ch.n)
                table.insert(temp, ch)
            end
        end
        current_playing_list = temp
        tts("Search complete")
    end
    
    views.btn_list_back.onClick = function() switchPage("page_categories", views.tv_cat_title) tts("Back to Categories") end
    
    views.lv_channels.setOnItemClickListener(AdapterView.OnItemClickListener{
        onItemClick = function(parent, v, position, id)
            switchPage("page_player", views.tv_player_status)
            playStation(position + 1, current_playing_list)
        end
    })
    
    -- Event: Player Actions
    views.btn_play_pause.onClick = function()
        local st = current_playing_list[current_station_index]
        if current_play_type == "RADIO" and radio_player then
            if isPlaying then 
                radio_player.pause() 
                isPlaying = false
                if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) timeoutRunnable = nil end
                tts(st.n .. " pause ho gaya hai") 
            else 
                radio_player.start() 
                isPlaying = true
                tts(st.n .. " play ho gaya hai") 
            end
        elseif current_play_type == "TV" and tv_video_view then
            if isPlaying then 
                tv_video_view.pause() 
                isPlaying = false
                if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) timeoutRunnable = nil end
                tts(st.n .. " pause ho gaya hai") 
            else 
                tv_video_view.start() 
                isPlaying = true
                tts(st.n .. " play ho gaya hai") 
            end
        end
        if st then updatePlayerUI(st) end
    end
    
    views.btn_next.onClick = function() 
        if current_playing_list and #current_playing_list > 0 then
            playStation(current_station_index + 1, current_playing_list) 
        end
    end
    
    views.btn_prev.onClick = function() 
        if current_playing_list and #current_playing_list > 0 then
            playStation(current_station_index - 1, current_playing_list) 
        end
    end
    
    views.btn_fav.onClick = function()
        local st = current_playing_list[current_station_index]
        if not st then return end
        local isFav, idx = isFavorite(st.u, st.type)
        if isFav then 
            if st.type == "RADIO" then table.remove(list_favorites_radio, idx) else table.remove(list_favorites_tv, idx) end
            tts("Favorite se remove ho gaya") 
        else 
            if st.type == "RADIO" then table.insert(list_favorites_radio, st) else table.insert(list_favorites_tv, st) end
            tts("Favorite mein add ho gaya") 
        end
        saveFavorites()
        updatePlayerUI(st)
    end
    
    views.btn_player_close.onClick = function()
        pcall(function() radio_player.stop() end)
        pcall(function() tv_video_view.stopPlayback() tv_video_view.setVisibility(View.GONE) end)
        isPlaying = false
        if playRunnable then mainHandler.removeCallbacks(playRunnable) end
        if timeoutRunnable then mainHandler.removeCallbacks(timeoutRunnable) end
        
        switchPage("page_list")
        pcall(function()
            views.lv_channels.setSelection(current_station_index - 1)
            views.lv_channels.requestFocusFromTouch()
            views.lv_channels.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
        end)
        tts("Player closed")
    end
    
