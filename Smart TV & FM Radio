local function focusOnView(v)
    if v then
        mainHandler.postDelayed(Runnable{run=function()
            pcall(function()
                v.setFocusable(true)
                v.requestFocus()
                v.sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_FOCUSED)
            end)
        end}, 200)
    end
end

