-- TTS Setup
local tts = nil
local ttsReady = false

function initTTS()
  -- Phone mein jo TTS engine/language pehle se select hai (Settings > Text-to-Speech),
  -- usi ko use karega. Koi bhi Locale ya engine force nahin kiya ja raha,
  -- taake Google ka TTS zabardasti na chale, balke user ka apna selected
  -- English/USA TTS hi bolega.
  tts = TextToSpeech(service, TextToSpeech.OnInitListener{
    onInit = function(status)
      if status == TextToSpeech.SUCCESS then
        ttsReady = true
      end
    end
  })
end

initTTS()

function speak(text)
  if tts and ttsReady then
    pcall(function()
      tts.speak(text, TextToSpeech.QUEUE_FLUSH, nil, nil)
    end)
  end
end

function loadFavorites()
  local json = prefs.getString("fav_list", "[]")
  local list = {}
  local arr = JSONArray(json)
  for i=0, arr.length()-1 do
    local obj = arr.getJSONObject(i)
    table.insert(list, {name=obj.getString("name"), url=obj.getString("url"), cat="Favourite"})
  end
  return list
end

function saveFavorites(list)
  local arr = JSONArray()
  for _, ch in ipairs(list) do
    local obj = JSONObject()
    obj.put("name", ch.name)
    obj.put("url", ch.url)
    obj.put("cat", "Favourite")
    arr.put(obj)
  end
  prefs.edit().putString("fav_list", arr.toString()).commit()
end

