local currentVolume = 0

-- Audio Ducking Function
function speak(msg)
  if service and service.speak then
    local am = audioManager
    local stream = AudioManager.STREAM_MUSIC
    currentVolume = am.getStreamVolume(stream)
    am.setStreamVolume(stream, math.floor(am.getStreamMaxVolume(stream) * 0.2), 0)
    service.speak(msg)
    task(3000, function() am.setStreamVolume(stream, currentVolume, 0) end)
  end
end

function updateVolTts()
  local max = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
  local cur = audioManager.getStreamVolume(AudioManager.STREAM_MUSIC)
  currentVolume = cur
  local percent = math.floor((cur / max) * 100)
  speak(percent .. " فیصد")
end

function startStreaming(url, playPauseBtn, name)
  player.reset()
  player.setAudioStreamType(AudioManager.STREAM_MUSIC)
  player.setDataSource(url)
  player.prepareAsync()
  player.setOnPreparedListener(MediaPlayer.OnPreparedListener{
    onPrepared = function(mp) 
      mp.start() 
      if playPauseBtn then playPauseBtn.setText("Stop Radio") end 
      speak("چینل پلے ہو گیا " .. (name and (": " .. name) or ""))
    end
  })
  player.setOnErrorListener(MediaPlayer.OnErrorListener{
    onError = function(mp, what, extra)
      local msg = "چینل چل نہیں سکا"
      if what == 1 then msg = "نیٹ ورک کا مسئلہ ہے" end
      speak(msg)
      if playPauseBtn then playPauseBtn.setText("Play") end
      return true
    end
  })
end

