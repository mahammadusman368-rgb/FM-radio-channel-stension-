  wa_btn.onClick = function() service.getContext().startActivity(Intent(Intent.ACTION_VIEW, Uri.parse("https://wa.me/"..whatsapp_number))) end
  copy_btn.onClick = function() service.getContext().getSystemService(Context.CLIPBOARD_SERVICE).setPrimaryClip(ClipData.newPlainText("label", whatsapp_number)) speak("نمبر کاپی ہو گیا") end
  back_btn.onClick = function() dlgAbout.dismiss() mainMenu() end
end

function mainMenu()
  local layout = {LinearLayout, orientation="vertical", padding="20dp",
    {TextView, text="FM Radio Channel - Creator: Mohammad Usman", textSize="16sp", gravity="center", layout_marginBottom="20dp"},
    {Button, id="fav", text="Favorite"},
    {Button, id="pak", text="Pakistan"},
    {Button, id="ind", text="India"},
    {Button, id="eng", text="English"},
    {Button, id="spo", text="Sports"},
    {Button, id="add_ch", text="Add Channel"},
    {Button, id="abt", text="About & Support"},
    {Button, id="exit_btn", text="Go Back", layout_width="fill", layout_marginTop="10dp"}
  }
  local dlgMain = LuaDialog(service)
  dlgMain.setView(loadlayout(layout))
  dlgMain.show()
  
  fav.onClick = function() dlgMain.dismiss() showList("Favourite") end
  pak.onClick = function() dlgMain.dismiss() showList("Pakistan") end
  ind.onClick = function() dlgMain.dismiss() showList("India") end
  eng.onClick = function() dlgMain.dismiss() showList("English") end
  spo.onClick = function() dlgMain.dismiss() showList("Sports") end
  add_ch.onClick = function() showAddChannel(dlgMain) end
  abt.onClick = function() dlgMain.dismiss() showAbout() end
  exit_btn.onClick = function() if player then player.stop() player.release() end dlgMain.dismiss() end
end

mainMenu()