function startStreaming(url, playPauseBtn, name)
  pcall(function()
    player.reset()
    player.setAudioStreamType(AudioManager.STREAM_MUSIC)
    player.setDataSource(url)
    player.prepareAsync()

    local retried = false

    player.setOnPreparedListener(MediaPlayer.OnPreparedListener{
      onPrepared = function(mp)
        mp.start()
        currentChannelName = name
        speak("Channel started playing: " .. name)
        if playPauseBtn then
          mainHandler.post(function()
            playPauseBtn.setText("Stop Radio")
          end)
        end
      end
    })

    player.setOnErrorListener(MediaPlayer.OnErrorListener{
      onError = function(mp, what, extra)
        if not retried then
          retried = true
          pcall(function()
            mp.reset()
            mp.setAudioStreamType(AudioManager.STREAM_MUSIC)
            mp.setDataSource(url)
            mp.prepareAsync()
          end)
          return true
        end

        local errorMsg = "Channel failed to play"
        if what == 1 then
          errorMsg = "Channel failed to play: Network issue"
        elseif what == 100 then
          errorMsg = "Channel failed to play: Server not available"
        else
          errorMsg = "Channel failed to play: Error " .. tostring(what)
        end
        speak(errorMsg)
        if playPauseBtn then
          mainHandler.post(function()
            playPauseBtn.setText("Play")
          end)
        end
        return true
      end
    })
  end)
end

-- ================= Volume Control =================
function getVolumePercent()
  local max = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
  local cur = audioManager.getStreamVolume(AudioManager.STREAM_MUSIC)
  if max == 0 then return 0 end
  return math.floor((cur / max) * 100 + 0.5)
end

function volumeUp()
  pcall(function()
    audioManager.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_RAISE, AudioManager.FLAG_SHOW_UI)
  end)
  local pct = getVolumePercent()
  speak("Volume " .. pct .. " percent badh gaya hai")
end

function volumeDown()
  pcall(function()
    audioManager.adjustStreamVolume(AudioManager.STREAM_MUSIC, AudioManager.ADJUST_LOWER, AudioManager.FLAG_SHOW_UI)
  end)
  local pct = getVolumePercent()
  speak("Volume " .. pct .. " percent kam ho gaya hai")
end

-- ================= Sleep Timer =================
function cancelSleepTimer()
  if sleepTimerRunnable then
    mainHandler.removeCallbacks(sleepTimerRunnable)
    sleepTimerRunnable = nil
  end
end

function startSleepTimer(minutes)
  cancelSleepTimer()
  local ms = minutes * 60 * 1000
  sleepTimerRunnable = function()
    pcall(function()
      if player and player.isPlaying() then
        player.stop()
      end
    end)
    speak("Sleep timer ended. Radio stopped.")
    if currentPlayerDialog then
      pcall(function() currentPlayerDialog.dismiss() end)
      currentPlayerDialog = nil
    end
    sleepTimerRunnable = nil
  end
  mainHandler.postDelayed(sleepTimerRunnable, ms)
  speak("Sleep timer set for " .. minutes .. " minutes")
end

