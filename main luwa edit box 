local monthNames = {
  january=0, february=1, march=2, april=3, may=4, june=5,
  july=6, august=7, september=8, october=9, november=10, december=11
}

function loadReminders()
  local json = reminderPrefs.getString("rem_list", "[]")
  local list = {}
  local arr = JSONArray(json)
  for i=0, arr.length()-1 do
    local obj = arr.getJSONObject(i)
    table.insert(list, {
      id = obj.getString("id"),
      channel = obj.getString("channel"),
      dateStr = obj.getString("dateStr"),
      hour = obj.getInt("hour"),
      minute = obj.getInt("minute"),
      ampm = obj.getString("ampm"),
      timestamp = obj.getDouble("timestamp")
    })
  end
  return list
end

function saveReminders(list)
  local arr = JSONArray()
  for _, r in ipairs(list) do
    local obj = JSONObject()
    obj.put("id", r.id)
    obj.put("channel", r.channel)
    obj.put("dateStr", r.dateStr)
    obj.put("hour", r.hour)
    obj.put("minute", r.minute)
    obj.put("ampm", r.ampm)
    obj.put("timestamp", r.timestamp)
    arr.put(obj)
  end
  reminderPrefs.edit().putString("rem_list", arr.toString()).commit()
end

reminders = loadReminders()

function cancelReminderRunnable(id)
  if reminderRunnables[id] then
    mainHandler.removeCallbacks(reminderRunnables[id])
    reminderRunnables[id] = nil
  end
end

function scheduleReminder(r)
  local now = Calendar.getInstance().getTimeInMillis()
  local delay = r.timestamp - now
  if delay <= 0 then return end
  local runnable = function()
    speak("Reminder: " .. r.channel .. " ka time ho gaya hai. Aapka program " .. r.dateStr .. " ko " .. r.hour .. ":" .. string.format("%02d", r.minute) .. " " .. r.ampm .. " par set kiya gaya tha, ab suna sakte hain.")
    reminderRunnables[r.id] = nil
  end
  reminderRunnables[r.id] = runnable
  mainHandler.postDelayed(runnable, delay)
end

-- schedule all pending (future) reminders on load
for _, r in ipairs(reminders) do
  scheduleReminder(r)
end

