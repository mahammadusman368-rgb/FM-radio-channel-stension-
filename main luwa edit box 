function loadFavorites()
  local json = prefs.getString("fav_list", "[]")
  local list = {}
  local arr = JSONArray(json)
  for i=0, arr.length()-1 do
    local obj = arr.getJSONObject(i)
    table.insert(list, {name=obj.getString("name"), url=obj.getString("url"), cat="Favourite"})
  end
  return list
end

function saveFavorites(list)
  local arr = JSONArray()
  for _, ch in ipairs(list) do
    local obj = JSONObject()
    obj.put("name", ch.name)
    obj.put("url", ch.url)
    obj.put("cat", "Favourite")
    arr.put(obj)
  end
  prefs.edit().putString("fav_list", arr.toString()).commit()
end

