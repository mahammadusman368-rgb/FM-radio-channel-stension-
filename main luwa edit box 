require "import"
import "android.widget.*"
import "android.content.*"
import "android.net.Uri"

local dlg = LuaDialog()
dlg.setTitle("Extension Update")

-- Aapka message aur details
local message_text = "Assalamu alaikum all friends, kya haal hai aapka?\n\nPurani FM radio channel aur Smart TV channel ki extensions (jo Mohammed Usman ne create ki thi) ko block kar diya gaya hai. In dono ko ek hi mein fix karke ek nayi extension launch kar di gayi hai.\n\nJis user ne bhi nayi extension leni hai, wo niche diye gaye WhatsApp par rabta karein."
local wa_number = "03261421100"
local wa_link = "https://wa.me/923261421100" 

local layout = {
  LinearLayout;
  orientation = "vertical";
  padding = "25dp";
  {
    TextView;
    text = message_text;
    textSize = "16sp";
    layout_marginBottom = "15dp";
  };
  {
    TextView;
    text = "Creator: Mohammed Usman\nWhatsApp: " .. wa_number;
    textSize = "17sp";
    textColor = "#000000";
    layout_marginBottom = "20dp";
  };
  {
    Button;
    text = "Copy WhatsApp Number";
    textSize = "16sp";
    layout_marginBottom = "10dp";
    onClick = function()
      -- Sirf number copy karne ka function
      service.getSystemService(Context.CLIPBOARD_SERVICE).setText(wa_number)
      print("Number copy ho gaya hai")
    end;
  };
  {
    Button;
    text = "Contact WhatsApp";
    textSize = "16sp";
    layout_marginBottom = "10dp";
    onClick = function()
      -- Direct WhatsApp open karne aur menu close karne ka function
      local intent = Intent(Intent.ACTION_VIEW)
      intent.setData(Uri.parse(wa_link))
      service.startActivity(intent)
      dlg.dismiss()
    end;
  };
  {
    Button;
    text = "Go Back";
    textSize = "16sp";
    onClick = function()
      dlg.dismiss()
    end;
  };
}

dlg.setView(loadlayout(layout))
dlg.show()