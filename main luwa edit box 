function showList(category)
  current_category = category
  local source = (category == "Favourite") and favorites or {}
  if category ~= "Favourite" then
    for _, ch in ipairs(all_channels) do if ch.cat == category then table.insert(source, ch) end end
  end

  local filtered = source
  local headerText = category .. " - " .. #source .. " Channels"

  local layout = {LinearLayout, orientation="vertical", padding="15dp",
    {TextView, text=headerText, textSize="16sp", gravity="center", layout_marginBottom="5dp"}
  }

  if category ~= "Favourite" then
    table.insert(layout, {LinearLayout, orientation="horizontal",
      {EditText, id="search_box", hint="Search...", layout_weight="1"},
      {Button, id="search_btn", text="Search"}
    })
  end

  table.insert(layout, {ListView, id="list", layout_width="fill", layout_height="0dp", layout_weight="1"})
  table.insert(layout, {Button, id="back_btn", text="Go Back", layout_width="fill"})

  local dlg = LuaDialog(service)
  dlg.setView(loadlayout(layout))
  dlg.show()

  local adapter = ArrayAdapter(service, android.R.layout.simple_list_item_1, {})
  list.setAdapter(adapter)

  local function refresh(data)
    adapter.clear()
    for _, ch in ipairs(data) do adapter.add(ch.name) end
  end
  refresh(filtered)
  list.setSelection(lastPosition)

  if category ~= "Favourite" then
    search_btn.onClick = function()
      local q = search_box.getText().toString():lower()
      filtered = {}
      for _, ch in ipairs(source) do if ch.name:lower():find(q) then table.insert(filtered, ch) end end
      refresh(filtered)
    end
  end

  list.onItemClick = function(l,v,pos,id)
    lastPosition = pos
    dlg.dismiss()
    openPlayer(filtered, pos+1, category == "Favourite")
  end
  back_btn.onClick = function() dlg.dismiss() mainMenu() end
end

function openPlayer(list, pos, isFavList)
  local channel = list[pos]
  local layout = {LinearLayout, orientation="vertical", padding="15dp",
    {TextView, text=channel.name, textSize="18sp", gravity="center", layout_marginBottom="10dp"},
    {Button, id="play_pause_btn", text="Play", layout_width="fill"},
    {LinearLayout, orientation="horizontal", layout_width="fill",
      {Button, id="next_btn", text="Next", layout_weight="1"},
      {Button, id="prev_btn", text="Previous", layout_weight="1"}
    },
    {LinearLayout, orientation="horizontal", layout_width="fill",
      {Button, id="vol_up_btn", text="Volume +", layout_weight="1"},
      {Button, id="vol_down_btn", text="Volume -", layout_weight="1"}
    },
    {Button, id="fav_btn", text=isFavList and "Remove from Favourite" or "Add to Favourite", layout_width="fill"},
    {Button, id="back_btn", text="Back", layout_width="fill"}
  }
  local dlg2 = LuaDialog(service)
  dlg2.setView(loadlayout(layout))
  dlg2.show()
  currentPlayerDialog = dlg2

  play_pause_btn.onClick = function()
    if player.isPlaying() then
      player.stop()
      play_pause_btn.setText("Play")
      speak("Channel stopped")
    else
      startStreaming(channel.url, play_pause_btn, channel.name)
    end
  end

  next_btn.onClick = function()
    if pos < #list then
      pos = pos + 1
      channel = list[pos]
      startStreaming(channel.url, play_pause_btn, channel.name)
      speak("Next channel: " .. channel.name)
      dlg2.setTitle(channel.name)
    end
  end

  prev_btn.onClick = function()
    if pos > 1 then
      pos = pos - 1
      channel = list[pos]
      startStreaming(channel.url, play_pause_btn, channel.name)
      speak("Previous channel: " .. channel.name)
      dlg2.setTitle(channel.name)
    end
  end

  vol_up_btn.onClick = function() volumeUp() end
  vol_down_btn.onClick = function() volumeDown() end

  fav_btn.onClick = function()
    if isFavList then
      for i, ch in ipairs(favorites) do if ch.name == channel.name then table.remove(favorites, i) break end end
      saveFavorites(favorites)
      speak("Removed from favourites: " .. channel.name)
      dlg2.dismiss()
      showList("Favourite")
    else
      local exists = false
      for _, ch in ipairs(favorites) do if ch.name == channel.name then exists = true break end end
      if exists then
        speak("Already in favourites: " .. channel.name)
      else
        table.insert(favorites, channel)
        saveFavorites(favorites)
        speak("Added to favourites: " .. channel.name)
      end
    end
  end
  back_btn.onClick = function()
    if player.isPlaying() then
      player.stop()
      speak("Channel stopped")
    end
    currentPlayerDialog = nil
    dlg2.dismiss()
    showList(current_category)
  end
end

