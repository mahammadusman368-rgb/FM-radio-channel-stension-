function speak(msg)
  service.speak(msg)
end

function isNetworkAvailable()
  local cm = service.getContext().getSystemService(Context.CONNECTIVITY_SERVICE)
  local netInfo = cm.getActiveNetworkInfo()
  return netInfo ~= nil and netInfo.isConnected()
end

function startStreaming(url, channelName)
  player.reset()
  player.setAudioStreamType(AudioManager.STREAM_MUSIC)

  if not isNetworkAvailable() then
    speak("Internet ka masla hai")
    return
  end

  local headers = HashMap()
  headers.put("User-Agent", "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36")

  player.setOnErrorListener(MediaPlayer.OnErrorListener{
    onError = function(mp, what, extra)
      speak("Server connect nahi ho pa raha. Error: " .. what .. "," .. extra)
      return true
    end
  })

  local success = pcall(function()
    local uri = Uri.parse(url)
    local context = service.getContext()
    player.setDataSource(context, uri, headers)
    player.setOnPreparedListener(MediaPlayer.OnPreparedListener{
      onPrepared = function(mp)
        mp.start()
        speak(channelName .. " play ho gaya hai")
      end
    })
    player.prepareAsync()
    speak("Connecting...")
  end)

  if not success then
    speak("URL galat ya server nahi mil raha")
  end
end

function showList()
  local names = {}
  for i,v in ipairs(channels) do
    table.insert(names, v.name)
  end

  local layout = {
    LinearLayout,
    orientation="vertical",
    padding="15dp",
    {
      TextView,
      text="Select Radio Channel",
      textSize="18sp",
      gravity="center",
      layout_width="fill"
    },
    {
      ListView,
      id="list",
      layout_width="fill",
      layout_height="0dp", 
      layout_weight="1"
    },
    {
      Button,
      id="back_btn",
      text="Go Back",
      layout_width="fill",
      layout_marginTop="10dp"
    }
  }

  dlg = LuaDialog(service)
  dlg.setView(loadlayout(layout))
  dlg.show()

  list.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, names))

  list.onItemClick = function(l,v,pos,id)
    dlg.dismiss()
    openPlayer(channels[pos+1])
  end

  back_btn.onClick = function()
    pcall(function()
      if player then
        if player.isPlaying() then player.stop() end
        player.release()
      end
    end)
    dlg.dismiss()
  end
end

function openPlayer(channel)
  local layout = {
    LinearLayout,
    orientation="vertical",
    padding="15dp",
    {
      TextView,
      text=channel.name,
      textSize="18sp",
      gravity="center",
      layout_width="fill"
    },
    {
      Button,
      id="play_btn",
      text="Play",
      layout_width="fill"
    },
    {
      Button,
      id="stop_btn",
      text="Stop",
      layout_width="fill"
    },
    {
      Button,
      id="back_btn",
      text="Back",
      layout_width="fill"
    }
  }

  dlg2 = LuaDialog(service)
  dlg2.setView(loadlayout(layout))
  dlg2.show()

  play_btn.onClick = function()
    startStreaming(channel.url, channel.name)
  end

  stop_btn.onClick = function()
    if player.isPlaying() then player.stop() end
    player.reset()
    speak("Radio band ho gaya hai")
  end

  back_btn.onClick = function()
    if player.isPlaying() then player.stop() end
    player.reset()
    dlg2.dismiss()
    showList()
  end
end

