function speak(msg)
  if service and service.speak then service.speak(msg) end
end

function isNetworkAvailable()
  local cm = service.getContext().getSystemService(Context.CONNECTIVITY_SERVICE)
  local netInfo = cm.getActiveNetworkInfo()
  return netInfo ~= nil and netInfo.isConnected()
end

function startStreaming(url, channelName, playPauseBtn)
  player.reset()
  player.setAudioStreamType(AudioManager.STREAM_MUSIC)

  if not isNetworkAvailable() then
    speak("Internet ka masla hai")
    return
  end

  local headers = HashMap()
  headers.put("User-Agent", "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36")

  player.setOnErrorListener(MediaPlayer.OnErrorListener{
    onError = function(mp, what, extra)
      speak("Server connect nahi ho pa raha.")
      if playPauseBtn then playPauseBtn.setText("Play") end
      return true
    end
  })

  local success = pcall(function()
    local uri = Uri.parse(url)
    local context = service.getContext()
    player.setDataSource(context, uri, headers)
    player.setOnPreparedListener(MediaPlayer.OnPreparedListener{
      onPrepared = function(mp)
        mp.start()
        speak(channelName .. " play ho gaya hai")
        if playPauseBtn then playPauseBtn.setText("Pause") end
      end
    })
    player.prepareAsync()
    speak("Connecting...")
  end)

  if not success then
    speak("URL galat ya server nahi mil raha")
    if playPauseBtn then playPauseBtn.setText("Play") end
  end
end

function showList(category)
  current_category = category
  local filtered = {}
  
  if category == "Favourite" then
    filtered = favorites
  else
    for _, ch in ipairs(all_channels) do
      if ch.cat == category then table.insert(filtered, ch) end
    end
  end

  local names = {}
  for _, v in ipairs(filtered) do table.insert(names, v.name) end

  local layout = {LinearLayout, orientation="vertical", padding="15dp",
    {TextView, text=category .. " Channels", textSize="18sp", gravity="center", layout_width="fill"},
    {ListView, id="list", layout_width="fill", layout_height="0dp", layout_weight="1"},
    {Button, id="back_btn", text="Go Back", layout_width="fill", layout_marginTop="10dp"}
  }

  dlg = LuaDialog(service)
  dlg.setView(loadlayout(layout))
  dlg.show()

  list.setAdapter(ArrayAdapter(service, android.R.layout.simple_list_item_1, names))
  if category ~= "Favourite" then list.setSelection(lastPosition) end

  list.onItemClick = function(l,v,pos,id)
    if category ~= "Favourite" then lastPosition = pos end
    dlg.dismiss()
    openPlayer(filtered[pos+1], pos+1)
  end

  back_btn.onClick = function()
    dlg.dismiss()
    mainMenu()
  end
end

function openPlayer(channel, indexOnList)
  local favButtonText = "Add to Favourite"
  if current_category == "Favourite" then
    favButtonText = "Delete From Favourite"
  end

  local initBtnText = "Play"
  if player.isPlaying() then initBtnText = "Pause" end

  local layout = {LinearLayout, orientation="vertical", padding="15dp",
    {TextView, text=channel.name, textSize="18sp", gravity="center", layout_width="fill"},
    {Button, id="play_pause_btn", text=initBtnText, layout_width="fill"},
    {Button, id="fav_btn", text=favButtonText, layout_width="fill"},
    {Button, id="back_btn", text="Back", layout_width="fill"}
  }

  dlg2 = LuaDialog(service)
  dlg2.setView(loadlayout(layout))
  dlg2.show()

  play_pause_btn.onClick = function()
    if player.isPlaying() then
      player.stop()
      player.reset()
      play_pause_btn.setText("Play")
      speak("Radio band ho gaya hai")
    else
      startStreaming(channel.url, channel.name, play_pause_btn)
    end
  end

  fav_btn.onClick = function()
    if current_category == "Favourite" then
      table.remove(favorites, indexOnList)
      speak("Channel favourite se delete ho gaya")
      dlg2.dismiss()
      showList("Favourite")
    else
      local exists = false
      for _, fav in ipairs(favorites) do
        if fav.name == channel.name then exists = true break end
      end
      if not exists then
        table.insert(favorites, channel)
        speak("Favourite mein add ho gaya")
      else
        speak("Yeh pehle se add hai")
      end
    end
  end

  back_btn.onClick = function()
    if player.isPlaying() then player.stop() end
    player.reset()
    dlg2.dismiss()
    showList(current_category)
  end
end

