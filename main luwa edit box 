    local minuteText = edit_minute.getText().toString()
    local ampm = edit_ampm.getText().toString():upper()

    if channel == "" or dateStr == "" or hourText == "" or minuteText == "" or (ampm ~= "AM" and ampm ~= "PM") then
      speak("Please fill all fields correctly. AM ya PM likhna zaroori hai")
      return
    end

    local hour = tonumber(hourText)
    local minute = tonumber(minuteText)
    if not hour or not minute or hour < 1 or hour > 12 or minute < 0 or minute > 59 then
      speak("Hour ya Minute sahi nahi hai")
      return
    end

    local day, monthName, year = dateStr:match("(%d+)%s+(%a+)%s+(%d+)")
    if not day then
      speak("Date ka format sahi nahi hai, jaise 15 January 2026")
      return
    end
    local monthIndex = monthNames[monthName:lower()]
    if not monthIndex then
      speak("Month ka naam sahi nahi hai")
      return
    end

    local hour24 = hour
    if ampm == "PM" and hour < 12 then hour24 = hour + 12 end
    if ampm == "AM" and hour == 12 then hour24 = 0 end

    local cal = Calendar.getInstance()
    cal.set(Calendar.YEAR, tonumber(year))
    cal.set(Calendar.MONTH, monthIndex)
    cal.set(Calendar.DAY_OF_MONTH, tonumber(day))
    cal.set(Calendar.HOUR_OF_DAY, hour24)
    cal.set(Calendar.MINUTE, minute)
    cal.set(Calendar.SECOND, 0)
    cal.set(Calendar.MILLISECOND, 0)
    local targetMillis = cal.getTimeInMillis()

    if targetMillis <= Calendar.getInstance().getTimeInMillis() then
      speak("Yeh time guzar chuka hai, sahi date aur time dalein")
      return
    end

    local id = tostring(targetMillis) .. "_" .. tostring(#reminders + 1)
    local r = {id=id, channel=channel, dateStr=dateStr, hour=hour, minute=minute, ampm=ampm, timestamp=targetMillis}
    table.insert(reminders, r)
    saveReminders(reminders)
    scheduleReminder(r)
    speak("Reminder save ho gaya hai: " .. channel .. " " .. dateStr .. " " .. hour .. ":" .. string.format("%02d", minute) .. " " .. ampm)
    dlg.dismiss()
    showReminderMenu()
  end

  back_btn.onClick = function() dlg.dismiss() showReminderMenu() end
end

